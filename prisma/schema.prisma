// Process Discovery — модель данных.
// Enum'ы намеренно заменены на String: SQLite не поддерживает Prisma-enum'ы,
// а строки остаются совместимыми с PostgreSQL. Значения валидируются zod-схемами.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  inviteCode  String    @unique
  hourlyRate  Float     @default(50) // ставка для costPerYear, настройка организации
  departments Json      @default("[]") // string[] — справочник отделов
  createdAt   DateTime  @default(now())
  users       User[]
  projects    Project[]
  candidates  ProcessCandidate[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  name         String
  role         String // OWNER | EMPLOYEE
  passwordHash String
  createdAt    DateTime @default(now())
  org          Organization @relation(fields: [orgId], references: [id])
  interviews   InterviewSession[]
  comments     Comment[]
  participations ProjectParticipant[]
}

model Project {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  description String   @default("")
  status      String // draft | capturing | mapping | validating | analyzed
  origin      String   @default("manual") // manual | auto_interview | auto_document
  autoReason  String? // человекочитаемое объяснение автосоздания
  createdAt   DateTime @default(now())
  org         Organization @relation(fields: [orgId], references: [id])
  sources     Source[]
  maps        ProcessMap[]
  followUps   FollowUpQuestion[]
  conflicts   Conflict[]
  interviewSessions InterviewSession[]
  participants ProjectParticipant[]
}

// Назначенные владельцем участники проекта: их интервью
// прикрепляются к проекту напрямую (приоритет над LLM-маршрутизацией)
model ProjectParticipant {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  assignedAt DateTime @default(now())
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// Найденный процесс-кандидат: обнаружен в интервью/анкетах/документах,
// ждёт решения владельца (создать проект или отклонить)
model ProcessCandidate {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  description String   @default("")
  origin      String // interview | document
  evidence    Json     @default("[]") // [{ who, what, ref }]
  status      String   @default("proposed") // proposed | accepted | dismissed
  createdAt   DateTime @default(now())
  org         Organization @relation(fields: [orgId], references: [id])
}

model Source {
  id         String   @id @default(cuid())
  projectId  String
  type       String // interview | document
  name       String
  fileRef    String? // путь в ./uploads
  status     String // pending | parsed | failed
  parsedJson Json? // единый формат: { candidateSteps, actors, rules, citations, ... }
  createdAt  DateTime @default(now())
  project    Project @relation(fields: [projectId], references: [id])
}

model InterviewSession {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  status    String // in_progress | awaiting_confirmation | completed | abandoned
  startedAt DateTime @default(now())
  endedAt   DateTime?
  agenda    Json // string[] темы
  coverage  Json // Record<topic, open|covered|skipped>
  transcript Json // [{ role, text, ts }]
  facts     Json // ExtractedFact[]
  summary   Json? // InterviewSummary
  user      User @relation(fields: [userId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
}

model ProcessMap {
  id        String   @id @default(cuid())
  projectId String
  version   Int
  json      Json // ProcessMapJson (zod, src/lib/schemas/map.ts)
  author    String // ai | human
  createdAt DateTime @default(now())
  project   Project @relation(fields: [projectId], references: [id])
  comments  Comment[]
  reports   AnalysisReport[]
}

model Comment {
  id         String  @id @default(cuid())
  mapId      String
  nodeId     String
  authorId   String
  body       String
  parentId   String?
  resolved   Boolean @default(false)
  createdAt  DateTime @default(now())
  map        ProcessMap @relation(fields: [mapId], references: [id])
  author     User @relation(fields: [authorId], references: [id])
  parent     Comment? @relation("Threads", fields: [parentId], references: [id])
  replies    Comment[] @relation("Threads")
  followUps  FollowUpQuestion[]
}

model FollowUpQuestion {
  id              String @id @default(cuid())
  projectId       String
  text            String
  status          String // open | asked
  sourceCommentId String?
  createdAt       DateTime @default(now())
  project         Project @relation(fields: [projectId], references: [id])
  sourceComment   Comment? @relation(fields: [sourceCommentId], references: [id])
}

model AnalysisReport {
  id        String   @id @default(cuid())
  mapId     String
  scores    Json // ScoredStep[] + meta
  swot      Json // { strengths[], weaknesses[], opportunities[], threats[] }
  createdAt DateTime @default(now())
  map       ProcessMap @relation(fields: [mapId], references: [id])
}

model Conflict {
  id                String @id @default(cuid())
  projectId         String
  docSourceId       String
  interviewSourceId String
  description       String
  resolved          Boolean @default(false)
  createdAt         DateTime @default(now())
  project           Project @relation(fields: [projectId], references: [id])
}
